# URL de tu proyecto Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co

# Clave anon/public de Supabase
VITE_SUPABASE_ANON_KEY=your-anon-key

# Puter.js permite usar Gemini sin API key propia.
# El modelo se publica porque no es un secreto y se consume desde el navegador.
VITE_GEMINI_MODEL=gemini-3.8-flash

# Clave privada de Groq para DataBot
# Obtén una en: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# Clave privada de OpenRouter para StockBot
# Obtén una en: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key
# Modelo gratuito estable; puedes cambiarlo por otro modelo :free disponible.
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_NAME=Farmacia Digital Multiagente

# Clave de Google Maps Platform (Maps JavaScript API + Routes API)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Dirección exacta de origen de la farmacia para calcular delivery
VITE_PHARMACY_ORIGIN=Jr. Jorge Chávez S/N, Plaza Principal, Yanahuanca, Daniel Alcides Carrión, Pasco, Perú 19001
# Coordenadas aproximadas de la farmacia demo en la Plaza Principal de Yanahuanca
VITE_PHARMACY_ORIGIN_LAT=-10.500000
VITE_PHARMACY_ORIGIN_LNG=-76.566700
