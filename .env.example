# URL de tu proyecto Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co

# Clave anon/public de Supabase
VITE_SUPABASE_ANON_KEY=your-anon-key

# Clave gratuita de Groq para FarmaBot
# Obtén una en: https://console.groq.com/keys
VITE_GROQ_API_KEY=your-groq-api-key

# Clave de Google Maps Platform (Maps JavaScript API + Routes API)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Dirección exacta de origen de la farmacia para calcular delivery
VITE_PHARMACY_ORIGIN=Jr. Jorge Chávez S/N, Plaza Principal, Yanahuanca, Daniel Alcides Carrión, Pasco, Perú 19001
# Coordenadas aproximadas de la farmacia demo en la Plaza Principal de Yanahuanca
VITE_PHARMACY_ORIGIN_LAT=-10.500000
VITE_PHARMACY_ORIGIN_LNG=-76.566700
