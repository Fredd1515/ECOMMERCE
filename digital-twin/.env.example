# Broker MQTT con TLS. EMQX Cloud Serverless, por ejemplo, usa mqtts://...:8883.
MQTT_URL=mqtts://tu-broker.example:8883
MQTT_USERNAME=usuario-mqtt
MQTT_PASSWORD=clave-mqtt
MQTT_BASE_TOPIC=digital-twin/openplc
MQTT_TLS_INSECURE=false

# OpenPLC está en la misma PC. No lo publiques en Internet.
OPENPLC_HOST=127.0.0.1
OPENPLC_PORT=502
MODBUS_UNIT_ID=1
MODBUS_TIMEOUT_SECONDS=3
POLL_INTERVAL_SECONDS=1

# Ajusta estas direcciones/cantidades al programa de OpenPLC.
MODBUS_COILS_ADDRESS=0
MODBUS_COILS_COUNT=8
MODBUS_DISCRETE_INPUTS_ADDRESS=0
MODBUS_DISCRETE_INPUTS_COUNT=8
MODBUS_HOLDING_REGISTERS_ADDRESS=0
MODBUS_HOLDING_REGISTERS_COUNT=10
MODBUS_INPUT_REGISTERS_ADDRESS=0
MODBUS_INPUT_REGISTERS_COUNT=10

