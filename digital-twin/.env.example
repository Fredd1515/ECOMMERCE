# Node-RED en Render recibe los datos y comandos por HTTPS.
NODE_RED_URL=https://digital-twin-node-red-yjfs.onrender.com
# Copia API_KEY desde Render > servicio > Environment. No la compartas.
API_KEY=pega_aqui_la_api_key_de_render

# OpenPLC y este puente deben ejecutarse en la misma PC. No publiques Modbus en Internet.
OPENPLC_HOST=127.0.0.1
OPENPLC_PORT=502
MODBUS_UNIT_ID=1
MODBUS_TIMEOUT_SECONDS=3
POLL_INTERVAL_SECONDS=1

# Ajusta estas direcciones/cantidades al programa de OpenPLC.
MODBUS_COILS_ADDRESS=0
MODBUS_COILS_COUNT=1
MODBUS_DISCRETE_INPUTS_ADDRESS=0
MODBUS_DISCRETE_INPUTS_COUNT=1
MODBUS_HOLDING_REGISTERS_ADDRESS=0
MODBUS_HOLDING_REGISTERS_COUNT=1
MODBUS_INPUT_REGISTERS_ADDRESS=0
MODBUS_INPUT_REGISTERS_COUNT=1

