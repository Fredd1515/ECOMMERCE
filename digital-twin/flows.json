[
  {
    "id": "flow-main",
    "type": "tab",
    "label": "Gemelo digital OpenPLC",
    "disabled": false,
    "info": "Puente MQTT/TLS entre OpenPLC local y Node-RED en Render."
  },
  {
    "id": "mqtt-state-in",
    "type": "digital-twin-mqtt-in",
    "z": "flow-main",
    "name": "Estado OpenPLC",
    "topic": "",
    "qos": "1",
    "x": 180,
    "y": 80,
    "wires": [["save-state", "state-debug"]]
  },
  {
    "id": "save-state",
    "type": "function",
    "z": "flow-main",
    "name": "Guardar último estado",
    "func": "const state = msg.payload && typeof msg.payload === 'object' ? msg.payload : { value: msg.payload };\nglobal.set('openplcState', state);\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 430,
    "y": 80,
    "wires": [[]]
  },
  {
    "id": "state-debug",
    "type": "debug",
    "z": "flow-main",
    "name": "Estado recibido",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "x": 420,
    "y": 130,
    "wires": []
  },
  {
    "id": "api-state-in",
    "type": "http in",
    "z": "flow-main",
    "name": "GET estado",
    "url": "/api/state",
    "method": "get",
    "upload": false,
    "swaggerDoc": "",
    "x": 130,
    "y": 220,
    "wires": [["api-state"]]
  },
  {
    "id": "api-state",
    "type": "function",
    "z": "flow-main",
    "name": "Responder estado",
    "func": "msg.headers = { 'content-type': 'application/json; charset=utf-8', 'cache-control': 'no-store' };\nmsg.payload = global.get('openplcState') || { connected: false, message: 'Esperando al puente local' };\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 220,
    "wires": [["api-state-response"]]
  },
  {
    "id": "api-state-response",
    "type": "http response",
    "z": "flow-main",
    "name": "Estado JSON",
    "statusCode": "",
    "headers": {},
    "x": 620,
    "y": 220,
    "wires": []
  },
  {
    "id": "api-command-in",
    "type": "http in",
    "z": "flow-main",
    "name": "POST comando",
    "url": "/api/command",
    "method": "post",
    "upload": false,
    "swaggerDoc": "",
    "x": 140,
    "y": 320,
    "wires": [["api-command-json"]]
  },
  {
    "id": "api-command-json",
    "type": "json",
    "z": "flow-main",
    "name": "Leer JSON",
    "property": "payload",
    "action": "obj",
    "pretty": false,
    "x": 340,
    "y": 320,
    "wires": [["api-command-validate"]]
  },
  {
    "id": "api-command-validate",
    "type": "function",
    "z": "flow-main",
    "name": "Validar comando",
    "func": "const command = msg.payload;\nconst validType = command && ['coils', 'holding_registers'].includes(command.type);\nconst validAddress = command && Number.isInteger(command.address) && command.address >= 0;\nconst validValues = command && Array.isArray(command.values) && command.values.length > 0;\nif (!validType || !validAddress || !validValues) {\n    msg.statusCode = 400;\n    msg.headers = { 'content-type': 'application/json; charset=utf-8' };\n    msg.payload = { error: 'Use { type: coils|holding_registers, address: número, values: [] }' };\n    return [null, msg];\n}\nconst response = {\n    statusCode: 202,\n    headers: { 'content-type': 'application/json; charset=utf-8' },\n    payload: { accepted: true, command }\n};\nreturn [{ payload: command }, response];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 570,
    "y": 320,
    "wires": [["mqtt-command-out"], ["api-command-response"]]
  },
  {
    "id": "mqtt-command-out",
    "type": "digital-twin-mqtt-out",
    "z": "flow-main",
    "name": "Comando OpenPLC",
    "topic": "",
    "qos": "1",
    "retain": "false",
    "x": 840,
    "y": 300,
    "wires": []
  },
  {
    "id": "api-command-response",
    "type": "http response",
    "z": "flow-main",
    "name": "Confirmar comando",
    "statusCode": "",
    "headers": {},
    "x": 850,
    "y": 360,
    "wires": []
  },
  {
    "id": "hmi-in",
    "type": "http in",
    "z": "flow-main",
    "name": "HMI",
    "url": "/",
    "method": "get",
    "upload": false,
    "swaggerDoc": "",
    "x": 100,
    "y": 470,
    "wires": [["hmi-template"]]
  },
  {
    "id": "hmi-template",
    "type": "template",
    "z": "flow-main",
    "name": "Dashboard HMI",
    "field": "payload",
    "fieldType": "msg",
    "format": "html",
    "syntax": "mustache",
    "template": "<!doctype html>\n<html lang=\"es\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Gemelo digital · OpenPLC</title>\n<style>body{font-family:system-ui,sans-serif;max-width:760px;margin:2rem auto;padding:0 1rem;background:#f4f7fb;color:#172033}main{background:white;padding:1.5rem;border-radius:14px;box-shadow:0 4px 18px #17203318}h1{margin-top:0}.badge{display:inline-block;padding:.25rem .6rem;border-radius:99px;background:#ddd}.ok{background:#c9f7d5;color:#075b24}.bad{background:#ffd4d4;color:#8a1010}pre{background:#101827;color:#d7e3f4;padding:1rem;border-radius:8px;overflow:auto}label{display:block;margin:.7rem 0}input,select,button{font:inherit;padding:.55rem;border:1px solid #b8c4d6;border-radius:7px}button{background:#1d64d8;color:white;border:0;cursor:pointer}small{color:#59677d}</style>\n</head>\n<body><main>\n<h1>Gemelo digital · OpenPLC</h1>\n<p>Node-RED en Render ↔ MQTT/TLS ↔ puente local ↔ OpenPLC</p>\n<p>Estado: <span id=\"status\" class=\"badge\">consultando…</span></p>\n<pre id=\"state\">Esperando datos…</pre>\n<h2>Enviar comando</h2>\n<label>Tipo <select id=\"type\"><option value=\"holding_registers\">Holding register</option><option value=\"coils\">Coil</option></select></label>\n<label>Dirección <input id=\"address\" type=\"number\" min=\"0\" value=\"0\"></label>\n<label>Valor <input id=\"value\" type=\"number\" value=\"1\"></label>\n<button onclick=\"sendCommand()\">Enviar</button> <span id=\"result\"></span>\n<p><small>Si configuraste API_KEY en Render, se solicitará una vez y quedará guardada en este navegador.</small></p>\n</main>\n<script>\nconst apiKey=localStorage.getItem('apiKey') ?? (prompt('API key (deja vacío si no configuraste una):') ?? '');\nif(apiKey)localStorage.setItem('apiKey',apiKey);\nconst headers=()=>apiKey?{'x-api-key':apiKey}:{};\nasync function refresh(){try{const r=await fetch('/api/state',{headers:headers()});const data=await r.json();document.getElementById('state').textContent=JSON.stringify(data,null,2);const s=document.getElementById('status');s.textContent=data.connected?'conectado':'desconectado';s.className='badge '+(data.connected?'ok':'bad')}catch(e){document.getElementById('status').textContent='error'}}\nasync function sendCommand(){const type=document.getElementById('type').value;const address=Number(document.getElementById('address').value);const raw=Number(document.getElementById('value').value);const values=type==='coils'?[Boolean(raw)]:[raw];const r=await fetch('/api/command',{method:'POST',headers:{...headers(),'content-type':'application/json'},body:JSON.stringify({type,address,values})});document.getElementById('result').textContent=await r.text();setTimeout(refresh,500)}\nrefresh();setInterval(refresh,5000);\n</script></body></html>",
    "output": "str",
    "x": 340,
    "y": 470,
    "wires": [["hmi-response"]]
  },
  {
    "id": "hmi-response",
    "type": "http response",
    "z": "flow-main",
    "name": "HMI HTML",
    "statusCode": "",
    "headers": {},
    "x": 570,
    "y": 470,
    "wires": []
  },
  {
    "id": "health-in",
    "type": "http in",
    "z": "flow-main",
    "name": "Health check",
    "url": "/healthz",
    "method": "get",
    "upload": false,
    "swaggerDoc": "",
    "x": 130,
    "y": 560,
    "wires": [["health-function"]]
  },
  {
    "id": "health-function",
    "type": "function",
    "z": "flow-main",
    "name": "OK",
    "func": "msg.headers = { 'content-type': 'application/json' };\nmsg.payload = { ok: true, service: 'digital-twin-node-red' };\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 350,
    "y": 560,
    "wires": [["health-response"]]
  },
  {
    "id": "health-response",
    "type": "http response",
    "z": "flow-main",
    "name": "Health JSON",
    "statusCode": "",
    "headers": {},
    "x": 570,
    "y": 560,
    "wires": []
  }
]

